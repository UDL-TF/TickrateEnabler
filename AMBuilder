import os

# Name of the VSP plugin
projectName = 'tickrate_enabler'

# Main source files for the VSP
sourceFiles = [
  'src/tickrate_enabler.cpp',
  os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook.cpp'),
  os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_impl_chookidman.cpp'),
  os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_impl_cproto.cpp'),
  os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_hookmangen.cpp'),
  os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_impl_chookmaninfo.cpp'),
  os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_impl_cvfnptr.cpp')
]

project = builder.LibraryProject(projectName)
project.sources += sourceFiles

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]
  if sdk['name'] in ['mock']:
    continue

  for cxx in builder.targets:
    if not cxx.target.arch in sdk['platforms'][cxx.target.platform]:
      continue
    
    binary = Extension.HL2ExtConfig(project, builder, cxx, projectName, sdk)
    binary.compiler.defines += ['HAVE_STRING_H']
    
    # Add architecture-specific SourceHook hook manager implementation
    if cxx.target.arch == 'x86':
      binary.sources += [os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_hookmangen_x86.cpp')]
    elif cxx.target.arch == 'x86_64':
      binary.sources += [os.path.join(Extension.mms_root, 'core', 'sourcehook', 'sourcehook_hookmangen_x86_64.cpp')]

Extension.extensions += builder.Add(project)
